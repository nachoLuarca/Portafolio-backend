# Servidor
PORT=4000
FRONTEND_URL=http://localhost:5173

# Base de datos PostgreSQL
# Estos valores coinciden con el contenedor "db" de docker-compose.yml
# (usuario "portfolio", contraseña "portfolio_pass", base "portfolio_db").
# Si levantaste ese contenedor con `docker compose up -d db`, esto funciona tal cual.
DATABASE_URL=postgresql://portfolio:portfolio_pass@localhost:5432/portfolio_db

# JWT
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=7d

# Usuario admin inicial (usado solo por db/seed.js)
ADMIN_EMAIL=tu-email@ejemplo.com
ADMIN_PASSWORD=CambiaEstaPassword123!
ADMIN_NAME=Tu Nombre
