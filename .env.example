# Servidor
PORT=4000
FRONTEND_URL=http://localhost:5173
# Definir solo si hay un reverse proxy real delante del backend (nginx, Caddy,
# balanceador del hosting). Habilita que express confíe en X-Forwarded-For
# para identificar la IP real del cliente (usada por el rate limiter).
# Dejar vacío si el backend recibe tráfico directo de Internet.
# TRUST_PROXY=1

# Base de datos PostgreSQL
# Estos valores coinciden con el contenedor "db" de docker-compose.yml
# (usuario "portfolio", contraseña "portfolio_pass", base "portfolio_db").
# Si levantaste ese contenedor con `docker compose up -d db`, esto funciona tal cual.
DATABASE_URL=postgresql://portfolio:CHANGE_ME@localhost:5432/portfolio_db

JWT_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=15m

JWT_REFRESH_SECRET=CHANGE_ME_WITH_ANOTHER_LONG_RANDOM_SECRET
JWT_REFRESH_EXPIRES_IN=7d

ADMIN_EMAIL=tu-email@ejemplo.com
ADMIN_PASSWORD=CHANGE_ME
ADMIN_NAME=Tu Nombre
